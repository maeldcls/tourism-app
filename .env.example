# ============================================================
# Copier ce fichier en .env et remplir chaque valeur CHANGE_ME
# ============================================================

# --- Base de données ---
# Mot de passe PostgreSQL (utilisé par le service db et l'API)
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# URL de connexion (le hostname "db" est le nom du service docker-compose)
DATABASE_URL=postgresql://postgres:CHANGE_ME_strong_password@db:5432/tourism_app_db

# --- Sécurité ---
# Clé secrète JWT — générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_random_secret

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
